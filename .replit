modules = ["php-8.2", "python-3.11", "postgresql-16"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "MySQL Database"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "MySQL Database"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/db_start.sh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PHP_CLI_SERVER_WORKERS=8 php -c php.ini -S 0.0.0.0:5000 -t ."
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
VPS_DEPLOY_PATH = "/var/www/myjoin"
VPS_HOST = "103.118.17.117"
VPS_SSH_PORT = "22"
VPS_SSH_USER = "root"

[postMerge]
path = "scripts/post_merge.sh"
timeoutMs = 120000
